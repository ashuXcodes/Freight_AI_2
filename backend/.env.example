# HTTP port used by the Express API
PORT=5000

# Application runtime environment
NODE_ENV=development

# MongoDB connection string. Example for a local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/freight_ai

# Use a unique, randomly generated value of at least 32 characters.
JWT_SECRET=freightai_super_secret_key_2026_change_this_to_something_long
